<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabeçalho -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAT108 • NÓ DE BORDA"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitor de Vibração"
            android:textColor="#F8FAFC"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reconciliação WLS (1g) e Detecção de Falhas em Tempo Real"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="18dp" />

        <!-- Card 1: Status da Aquisição e Contador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#64748B"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SERVIÇO PARADO"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSampleCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F8FAFC"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amostras adquiridas (ciclo determinístico de 50 ms / 20 Hz)"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Card 2: Comparativo Visual de Reconciliação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECONCILIAÇÃO SOB RESTRIÇÃO DE GRAVIDADE (1g)"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="12dp" />

            <!-- Resíduo Bruto -->
            <TextView
                android:id="@+id/tvResidualBefore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resíduo Bruto (Antes): 0.0000 m/s²"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <ProgressBar
                android:id="@+id/pbResidualBefore"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FBBF24"
                android:progressBackgroundTint="#334155"
                android:layout_marginBottom="14dp" />

            <!-- Resíduo Reconciliado -->
            <TextView
                android:id="@+id/tvResidualAfter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resíduo Reconciliado (Depois): 0.000000 m/s²"
                android:textColor="#34D399"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <ProgressBar
                android:id="@+id/pbResidualAfter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#34D399"
                android:progressBackgroundTint="#334155" />
        </LinearLayout>

        <!-- Card 3: Alerta do Detector de Erro Grosseiro -->
        <LinearLayout
            android:id="@+id/cardAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#064E3B"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETECTOR DE ERRO GROSSEIRO (LIMIAR 3σ)"
                android:textColor="#A7F3D0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvGrossErrorStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPERAÇÃO NOMINAL (1g ESTÁVEL)"
                android:textColor="#ECFDF5"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botões de Ação -->
        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="▶  Iniciar Aquisição Contínua (50 ms)"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:backgroundTint="#38BDF8"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnInjectFault"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚡  Injetar Falha Determinística (+6 m/s²)"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:backgroundTint="#F59E0B"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnStopService"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="■  Encerrar Aquisição"
            android:textColor="#F8FAFC"
            android:backgroundTint="#334155" />

    </LinearLayout>
</ScrollView>